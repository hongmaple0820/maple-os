{
  "$schema": "https://raw.githubusercontent.com/nickel-org/nickel.rs/master/nickel/schema.json",
  "productName": "MapleOS",
  "version": "0.1.0",
  "identifier": "com.mapleos.desktop",
  "build": {
    "beforeDevCommand": "cd ../web && pnpm dev",
    "devUrl": "http://localhost:3000",
    "beforeBuildCommand": "cd ../web && pnpm build:static",
    "frontendDist": "../web/out"
  },
  "app": {
    "windows": [
      {
        "title": "MapleOS",
        "width": 1280,
        "height": 800,
        "minWidth": 960,
        "minHeight": 600,
        "resizable": true,
        "fullscreen": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "externalBin": [
      "mapleos-server"
    ]
  },
  "plugins": {
    "shell": {
      "sidecar": true,
      "scope": [
        {
          "name": "mapleos-server",
          "sidecar": true,
          "args": true
        }
      ]
    }
  }
}