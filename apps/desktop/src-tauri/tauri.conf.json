{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "MapleOS",
  "version": "0.1.0",
  "identifier": "com.mapleos.desktop",
  "mainBinaryName": "MapleOS",
  "build": {
    "beforeDevCommand": "pnpm --filter=mapleos-web dev",
    "devUrl": "http://localhost:3000",
    "beforeBuildCommand": "NEXT_STATIC_EXPORT=1 pnpm --filter=mapleos-web build",
    "frontendDist": "../web/out"
  },
  "app": {
    "windows": [
      {
        "title": "MapleOS",
        "width": 1280,
        "height": 800,
        "minWidth": 960,
        "minHeight": 600,
        "resizable": true,
        "dragDropEnabled": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "externalBin": [
      "binaries/mapleos-server"
    ]
  },
  "plugins": {
    "shell": {
      "open": true
    }
  }
}
