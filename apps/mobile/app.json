{
  "expo": {
    "name": "MapleOS",
    "slug": "mapleos-mobile",
    "version": "0.1.0",
    "orientation": "default",
    "scheme": "mapleos",
    "userInterfaceStyle": "dark",
    "newArchEnabled": true,
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.mapleos.mobile"
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#1a1a2e"
      },
      "package": "com.mapleos.mobile"
    },
    "plugins": ["expo-router"],
    "extra": {
      "router": {
        "origin": false
      }
    }
  }
}