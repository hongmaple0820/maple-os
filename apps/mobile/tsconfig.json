{
  "compilerOptions": {
    "strict": true,
    "target": "ESNext",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "jsx": "react-jsx",
    "paths": {
      "@/*": ["./src/*"]
    },
    "types": ["react-native", "node"]
  },
  "include": ["src/**/*", "app/**/*"],
  "extends": "expo/tsconfig.base"
}