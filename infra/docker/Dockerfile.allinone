# MapleOS All-in-One Dockerfile
# Single container with both Rust backend + Next.js static export

FROM rust:slim AS chef
RUN apt-get update && apt-get install -y pkg-config libsqlite3-dev && rm -rf /var/lib/apt/lists/*
RUN cargo install cargo-chef --locked
WORKDIR /app

# ── Planner: prepare cargo-chef recipe ──
# We must NOT include .gitmodules (scale-engine submodule is empty in Docker)
# and we must create stub src files so cargo metadata can parse all manifests
FROM chef AS planner
COPY Cargo.toml ./
# Copy all workspace member Cargo.toml files
COPY core/maple-engine/Cargo.toml core/maple-engine/Cargo.toml
COPY core/maple-llm/Cargo.toml core/maple-llm/Cargo.toml
COPY core/maple-agent/Cargo.toml core/maple-agent/Cargo.toml
COPY core/maple-kb/Cargo.toml core/maple-kb/Cargo.toml
COPY core/maple-sync/Cargo.toml core/maple-sync/Cargo.toml
COPY core/maple-gateway/Cargo.toml core/maple-gateway/Cargo.toml
COPY core/maple-collab/Cargo.toml core/maple-collab/Cargo.toml
COPY core/maple-rpc/Cargo.toml core/maple-rpc/Cargo.toml
COPY core/maple-macro/Cargo.toml core/maple-macro/Cargo.toml
COPY apps/cli/Cargo.toml apps/cli/Cargo.toml
COPY server/Cargo.toml server/Cargo.toml
# Create stub source files for ALL workspace members
# (cargo metadata requires src/lib.rs or src/main.rs to parse a manifest)
RUN mkdir -p core/maple-engine/src && echo 'pub fn _stub() {}' > core/maple-engine/src/lib.rs && \
    mkdir -p core/maple-llm/src && echo 'pub fn _stub() {}' > core/maple-llm/src/lib.rs && \
    mkdir -p core/maple-agent/src && echo 'pub fn _stub() {}' > core/maple-agent/src/lib.rs && \
    mkdir -p core/maple-kb/src && echo 'pub fn _stub() {}' > core/maple-kb/src/lib.rs && \
    mkdir -p core/maple-sync/src && echo 'pub fn _stub() {}' > core/maple-sync/src/lib.rs && \
    mkdir -p core/maple-gateway/src && echo 'pub fn _stub() {}' > core/maple-gateway/src/lib.rs && \
    mkdir -p core/maple-collab/src && echo 'pub fn _stub() {}' > core/maple-collab/src/lib.rs && \
    mkdir -p core/maple-rpc/src && echo 'pub fn _stub() {}' > core/maple-rpc/src/lib.rs && \
    mkdir -p core/maple-macro/src && echo 'pub fn _stub() {}' > core/maple-macro/src/lib.rs && \
    mkdir -p apps/cli/src && echo 'fn main() {}' > apps/cli/src/main.rs && \
    mkdir -p server/src && echo 'fn main() {}' > server/src/main.rs && \
    echo 'pub fn _stub() {}' > server/src/lib.rs
# No .gitmodules = no scale-engine submodule resolution attempt
RUN cargo chef prepare --recipe-path recipe.json

FROM chef AS builder
COPY --from=planner /app/recipe.json recipe.json
RUN cargo chef cook --release --recipe-path recipe.json
# Copy actual source (without .gitmodules)
COPY Cargo.toml ./
COPY core/ core/
COPY apps/cli/ apps/cli/
COPY server/ server/
# Remove submodule directory if it exists (empty in Docker context)
RUN rm -rf core/scale-engine
RUN cargo build --release -p mapleos-server

# Build frontend static export
FROM node:24-slim AS frontend
WORKDIR /app
RUN npm install -g pnpm@11.3.0
COPY package.json pnpm-lock.yaml pnpm-workspace.yaml turbo.json ./
COPY apps/web/package.json apps/web/
COPY packages/ui/package.json packages/ui/
COPY packages/sdk/package.json packages/sdk/
COPY packages/config/package.json packages/config/
RUN pnpm install --no-frozen-lockfile
COPY . .
RUN pnpm --filter=@mapleos/ui --filter=@mapleos/sdk build
RUN npx cross-env NEXT_STATIC_EXPORT=1 pnpm --filter=mapleos-web build

# Final image
FROM debian:bookworm-slim
RUN apt-get update && apt-get install -y ca-certificates libsqlite3-0 && rm -rf /var/lib/apt/lists/*

COPY --from=builder /app/target/release/mapleos-server /usr/local/bin/mapleos-server
COPY --from=frontend /app/apps/web/out /app/web
COPY migrations/ /app/migrations/
COPY config/ /app/config/

WORKDIR /app
EXPOSE 7788
ENV RUST_LOG=info
ENV MAPLEOS_WEB_DIR=/app/web

CMD ["mapleos-server"]
