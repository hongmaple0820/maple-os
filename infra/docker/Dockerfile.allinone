# MapleOS All-in-One Dockerfile
# Single container with both Rust backend + Next.js static export
# No separate web server needed — Rust serves the static files directly.

FROM rust:slim AS chef
RUN apt-get update && apt-get install -y pkg-config libsqlite3-dev && rm -rf /var/lib/apt/lists/*
RUN cargo install cargo-chef --locked
WORKDIR /app

FROM chef AS planner
COPY . .
RUN cargo chef prepare --recipe-path recipe.json

FROM chef AS builder
COPY --from=planner /app/recipe.json recipe.json
RUN cargo chef cook --release --recipe-path recipe.json
COPY . .
RUN cargo build --release -p mapleos-server

# Build frontend static export
FROM node:24-slim AS frontend
WORKDIR /app
RUN npm install -g pnpm@11.3.0
COPY package.json pnpm-lock.yaml pnpm-workspace.yaml turbo.json ./
COPY apps/web/package.json apps/web/
COPY packages/ui/package.json packages/ui/
COPY packages/sdk/package.json packages/sdk/
COPY packages/config/package.json packages/config/
RUN pnpm install --no-frozen-lockfile
COPY . .
RUN pnpm --filter=@mapleos/ui --filter=@mapleos/sdk build
RUN NEXT_STATIC_EXPORT=1 pnpm --filter=mapleos-web build

# Final image — all-in-one
FROM debian:bookworm-slim
RUN apt-get update && apt-get install -y ca-certificates libsqlite3-0 && rm -rf /var/lib/apt/lists/*

# Copy server binary
COPY --from=builder /app/target/release/mapleos-server /usr/local/bin/mapleos-server

# Copy static web export
COPY --from=frontend /app/apps/web/out /app/web

# Copy migrations + config
COPY migrations/ /app/migrations/
COPY config/ /app/config/

WORKDIR /app
EXPOSE 7788
ENV RUST_LOG=info
ENV MAPLEOS_WEB_DIR=/app/web

CMD ["mapleos-server"]
