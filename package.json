{
  "name": "mapleos",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "turbo dev",
    "build": "turbo build",
    "lint": "turbo lint",
    "typecheck": "turbo typecheck",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "desktop:dev": "pnpm --filter=mapleos-desktop dev",
    "desktop:build": "pnpm --filter=mapleos-desktop build"
  },
  "devDependencies": {
    "@playwright/test": "^1.60.0",
    "turbo": "^2.3.0"
  },
  "packageManager": "pnpm@11.3.0",
  "pnpm": {
    "onlyBuiltDependencies": [
      "sharp"
    ]
  }
}
